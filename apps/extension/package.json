{
  "name": "@aicc/extension",
  "displayName": "Persista",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "build:zip": "plasmo build --zip",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf build .plasmo"
  },
  "dependencies": {
    "@aicc/shared-types": "workspace:*",
    "@plasmohq/messaging": "^0.6.2",
    "@plasmohq/storage": "^1.15.0",
    "dexie": "^4.4.2",
    "plasmo": "^0.90.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@aicc/tsconfig": "workspace:*",
    "@types/chrome": "^0.0.310",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "manifest": {
    "name": "AI Context Continuity",
    "description": "Captures and preserves AI workflow context across sessions and platforms.",
    "permissions": [
      "storage",
      "tabs",
      "activeTab",
      "scripting",
      "alarms"
    ],
    "host_permissions": [
      "https://chat.openai.com/*",
      "https://chatgpt.com/*",
      "https://claude.ai/*",
      "https://gemini.google.com/*"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "assets/*"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ],
    "minimum_chrome_version": "116"
  }
}
