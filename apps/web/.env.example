# apps/web/.env.example
# Copy to .env.local for local development (gitignored).
# .env.development and .env.production hold committed, non-secret defaults.
#
# Loading order (Next.js, highest priority first):
#   .env.local           → gitignored, personal overrides (any env)
#   .env.development     → committed, dev defaults (NODE_ENV=development)
#   .env.production      → committed, prod defaults (NODE_ENV=production)
#   .env                 → committed, base defaults (all envs — avoid for secrets)
#
# Classification:
#   [PUBLIC]  NEXT_PUBLIC_* — bundled into client JS, safe for browser
#   [SECRET]  server-side only — never prefix with NEXT_PUBLIC_
#
# ── API ───────────────────────────────────────────────────────────────────────
# [PUBLIC] Backend API base URL visible in client-side fetch calls
NEXT_PUBLIC_API_URL=http://localhost:8080

# [PUBLIC] Application display name shown in UI
NEXT_PUBLIC_APP_NAME=AI Context Continuity

# ── Feature Flags ─────────────────────────────────────────────────────────────
# [PUBLIC] Enable developer debug panel in UI (set false in production)
NEXT_PUBLIC_DEBUG=false
