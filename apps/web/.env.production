# apps/web/.env.production — committed, loaded when NODE_ENV=production
# Safe to commit: contains only NEXT_PUBLIC_* values (no secrets).
# Override NEXT_PUBLIC_API_URL in your deployment platform (Vercel, Docker, etc.)

NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_APP_NAME=AI Context Continuity
NEXT_PUBLIC_DEBUG=false
