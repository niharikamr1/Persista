# Copy this file to .env and fill in values before running docker compose
# docker compose reads .env automatically from the same directory

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=aicc
POSTGRES_USER=aicc_user
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aicc-files

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
