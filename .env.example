# ═══════════════════════════════════════════════════════════════════════════
#  AI Context Continuity — Environment Variable Reference
#  Copy this file to .env and fill in every value marked [SECRET].
#
#  LOADING ORDER (highest priority wins):
#    1. Shell / CI environment variables
#    2. .env.local  (per-app, gitignored)
#    3. .env.{environment}  (Next.js per-environment defaults, committed)
#    4. .env  (this file, gitignored root copy, shared by all apps)
#    5. application-{profile}.yml  (Spring Boot fallbacks, committed)
#
#  SECRET POLICY:
#    [SECRET]  — never commit, generate per environment
#    [CONFIG]  — safe to commit, no sensitive data
#    [PUBLIC]  — exposed to browser, must not be sensitive
# ═══════════════════════════════════════════════════════════════════════════


# ── Environment identity ──────────────────────────────────────────────────────
# [CONFIG] One of: local | dev | staging | prod
APP_ENV=local


# ── PostgreSQL ────────────────────────────────────────────────────────────────
# [CONFIG]
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aicc
POSTGRES_USER=aicc_user
# [SECRET] — min 16 chars, unique per environment — generate: openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME


# ── MinIO object storage ──────────────────────────────────────────────────────
# [CONFIG]
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=aicc-files
# [SECRET] — generate: openssl rand -hex 12
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME


# ── Backend server ────────────────────────────────────────────────────────────
# [CONFIG]
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# [SECRET] — must be >= 256-bit (32+ chars) random value — generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# [CONFIG] — milliseconds
JWT_EXPIRY_MS=900000
REFRESH_TOKEN_EXPIRY_MS=604800000


# ── AI / Embeddings ───────────────────────────────────────────────────────────
# [SECRET] — your OpenAI API key
OPENAI_API_KEY=sk-placeholder

# [CONFIG]
EMBEDDING_MODEL=text-embedding-3-small


# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# [PUBLIC] — safe to expose to browser
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
NEXT_PUBLIC_APP_ENV=local


# ── Observability ─────────────────────────────────────────────────────────────
# [CONFIG]
GRAFANA_USER=admin
# [SECRET] — generate: openssl rand -hex 12
GRAFANA_PASSWORD=CHANGE_ME
